# Copiar a .env.local
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Admin de Medusa → Settings → Publishable API Keys → "Storefront"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Opcional: si hay más de una región, fija cuál usa la tienda.
# NEXT_PUBLIC_MEDUSA_REGION_ID=

# URL pública de la tienda (SEO, links canónicos).
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# 1 = sitio de demostración: muestra un aviso arriba y no se indexa en Google.
NEXT_PUBLIC_DEMO_MODE=
