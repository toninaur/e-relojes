{
  "name": "erelojes-ecommerce",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "backend",
    "storefront"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "backend:dev": "turbo dev --filter=@erelojes/backend",
    "storefront:dev": "turbo dev --filter=@erelojes/storefront"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.4",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    },
    "@swc/core": "1.15.33"
  },
  "allowScripts": {
    "@swc/core@1.15.33": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.7": true
  }
}
