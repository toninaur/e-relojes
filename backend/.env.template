# Copiar a .env y completar DATABASE_URL.
# La base se crea con `npx medusa db:setup --db erelojes_ecommerce` (desde e-commerce/backend).
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/erelojes_ecommerce
DB_NAME=erelojes_ecommerce

# Orígenes permitidos (storefront y admin), separados por coma.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# En producción, valores largos y aleatorios.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Opcional en local. En Railway se usa el Redis del proyecto.
# REDIS_URL=redis://localhost:6379
